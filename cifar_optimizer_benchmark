    "    OPT_NAMES = [\"sgd\", \"adamw\", \"c_adamw\", \"muon\", \"c_muon\"]\n",
    "    if all_results:\n",
    "        return all_results\n",
    "    results = {}\n",
    "    for opt in OPT_NAMES:\n",
    "        path = os.path.join(out_dir, f\"{opt}_{dataset}.csv\")\n",
    "        if os.path.exists(path):\n",
    "            df = pd.read_csv(path)\n",
    "            results[opt] = df.to_dict('records')\n",
    "    return results\n",
    "\n",
    "\n",
    "def plot_results(all_results, dataset=\"cifar10\", out_dir=\"runs\"):\n",
    "    results = load_or_use(all_results, out_dir, dataset)\n",
